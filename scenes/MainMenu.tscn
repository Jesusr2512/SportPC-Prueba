[node name="P2Select" type="OptionButton" parent="Margin/Root/ControllersCard/Grid"]
layout_mode = 2
custom_minimum_size = Vector2(320, 36)

[node name="ActionsCard" type="VBoxContainer" parent="Margin/Root"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 14

[node name="BtnCalibration" type="Button" parent="Margin/Root/ActionsCard"]
layout_mode = 2
custom_minimum_size = Vector2(0, 60)
theme_override_font_sizes/font_size = 21
text = "1. Sala de Calibración 6-Axis (Prueba 3D en vivo)"

[node name="RowAI" type="HBoxContainer" parent="Margin/Root/ActionsCard"]
layout_mode = 2
