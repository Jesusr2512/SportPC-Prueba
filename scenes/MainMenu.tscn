[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/MainMenu.gd" id="1"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.11, 0.2, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 32

[node name="Root" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Header" type="VBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Margin/Root/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "SPORT PC — Plaza 6-Axis"

[node name="Subtitle" type="Label" parent="Margin/Root/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "Controles reales por movimiento (Móvil Wi-Fi, DualShock 4, DualSense, Switch, Steam Controller 2 o Ratón)"

[node name="MobileCard" type="PanelContainer" parent="Margin/Root"]
layout_mode = 2

[node name="HBox" type="HBoxContainer" parent="Margin/Root/MobileCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="UrlLabel" type="Label" parent="Margin/Root/MobileCard/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
text = "Cargando URL..."

[node name="CopyBtn" type="Button" parent="Margin/Root/MobileCard/HBox"]
layout_mode = 2
text = "Copiar URL"

[node name="RefreshBtn" type="Button" parent="Margin/Root/MobileCard/HBox"]
layout_mode = 2
text = "Actualizar Mandos"

[node name="ControllersCard" type="PanelContainer" parent="Margin/Root"]
layout_mode = 2

[node name="Grid" type="GridContainer" parent="Margin/Root/ControllersCard"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 20
