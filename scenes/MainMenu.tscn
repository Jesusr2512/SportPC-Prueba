[node name="Hint" type="Label" parent="Margin/Root"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Tip móvil: acepta el aviso de certificado local la primera vez que entres por HTTPS para permitir el giroscopio. En Steam Controller 2 / PS4 / Switch, ejecuta directo sin capa XInput."

